# Auto detect text files and perform LF normalization
* text=auto

# --- 소스 파일 인코딩/줄바꿈 정책 ---
# 소스는 UTF-8로 저장합니다. 에디터 강제 규칙은 .editorconfig 참고.
*.cs         text diff=csharp
*.shader     text
*.hlsl       text
*.cginc      text
*.compute    text
*.json       text
*.csv        text
*.txt        text
*.md         text
*.uss        text
*.uxml       text

# Unity 직렬화 에셋 (YAML 텍스트)
*.unity      text
*.prefab     text
# .asset 은 타입에 따라 YAML 이거나 바이너리입니다.
# TerrainData 는 ForceText 직렬화에서도 항상 바이너리라, text 로 강제하면
# git 이 줄바꿈을 변환하며 파일을 깨뜨립니다. (실제로 New Terrain.asset 이 그렇게 손상되었습니다)
# text=auto 로 두면 git 이 NUL 바이트를 보고 파일마다 알아서 판단합니다.
*.asset      text=auto
*.mat        text
*.anim       text
*.controller text
*.meta       text
*.physicMaterial text

# 바이너리 (자동 판별에 맡기지 않음)
*.fbx        binary
*.blend      binary
*.png        binary
*.jpg        binary
*.jpeg       binary
*.gif        binary
*.psd        binary
*.tga        binary
*.tif        binary
*.exr        binary
*.hdr        binary
*.wav        binary
*.mp3        binary
*.ogg        binary
*.aif        binary
*.ttf        binary
*.otf        binary
*.dll        binary
*.so         binary
*.pdb        binary
*.unitypackage binary
