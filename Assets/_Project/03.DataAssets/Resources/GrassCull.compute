// 풀 인스턴스를 GPU에서 골라내는 컴퓨트 셰이더입니다.
//
// <b>무엇을 대신하는가.</b> 지금까지 풀은 유니티 터레인 디테일로 그렸습니다.
// 그 방식은 CPU가 패치(25m 격자)마다 그리기 명령을 만들고, 한 명령에 약 500 포기까지만
// 담깁니다. 즉 <b>그리기 횟수가 포기 수에 정비례</b>합니다. 이 게임은 CPU 바운드라
// 그 비례가 그대로 프레임 예산을 먹습니다.
//
// 여기서는 포기 전체를 GPU 버퍼에 올려 두고, 이 셰이더가 화면 안에 있는 것만 골라
// 색인을 추려 냅니다. CPU는 <b>종당 그리기 명령 하나</b>만 냅니다.
// 포기가 50만이든 200만이든 CPU 비용이 같습니다.
//
// 인스턴스 하나는 float4 입니다. xyz 가 심어진 자리, w 가 y축 회전(라디안)입니다.
// 크기 변화는 자리로부터 해시로 뽑으므로 따로 담지 않습니다. (버퍼를 절반으로 줄입니다)

#pragma kernel CSMain

// 심어진 포기 전부입니다. 로드할 때 한 번 채우고 그 뒤로 바뀌지 않습니다.
StructuredBuffer<float4> _Instances;

// 이번 프레임에 그릴 것들의 색인입니다. 아래에서 추려 담습니다.
AppendStructuredBuffer<uint> _VisibleIndices;

// 절두체 여섯 평면입니다. xyz 가 법선, w 가 거리입니다.
float4 _FrustumPlanes[6];

// 카메라 자리입니다. 거리로 자를 때 씁니다.
float3 _CameraPosition;

// 이 거리 밖은 그리지 않습니다. 제곱해서 넘겨 뿌리를 구하지 않습니다.
float _MaxDistanceSqr;

// 포기 하나가 차지하는 반경입니다. 절두체 판정을 구로 합니다.
// 점으로 판정하면 화면 가장자리에서 <b>잎은 걸치는데 밑동이 밖</b>인 포기가 사라집니다.
float _InstanceRadius;

// 실제로 담긴 포기 수입니다. 버퍼 크기보다 작을 수 있습니다.
uint _InstanceCount;

[numthreads(64, 1, 1)]
void CSMain(uint3 id : SV_DispatchThreadID)
{
    uint index = id.x;
    if (index >= _InstanceCount) return;

    float3 position = _Instances[index].xyz;

    // 1. 거리로 자릅니다. 절두체보다 싸므로 먼저 합니다.
    float3 toEye = position - _CameraPosition;
    if (dot(toEye, toEye) > _MaxDistanceSqr) return;

    // 2. 절두체 여섯 평면 밖이면 버립니다.
    //
    // 반경만큼 여유를 둡니다. 밑동이 평면 밖이어도 잎이 화면에 걸칠 수 있습니다.
    [unroll]
    for (int i = 0; i < 6; i++)
    {
        if (dot(_FrustumPlanes[i].xyz, position) + _FrustumPlanes[i].w < -_InstanceRadius) return;
    }

    _VisibleIndices.Append(index);
}
